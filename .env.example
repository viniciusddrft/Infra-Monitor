# Copie para .env e ajuste. O .env NÃO é versionado.
#
#   cp .env.example .env

# ── Postgres do compose ─────────────────────────────────────────────────────
POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor_dev
POSTGRES_DB=monitor
POSTGRES_PORT=5432

# ── senhas dos papéis da aplicação (migration 011) ──────────────────────────
# Em produção vêm do gestor de segredos, nunca de arquivo.
MONITOR_MIGRATE_PASSWORD=migrate_dev
MONITOR_API_PASSWORD=api_dev
MONITOR_WORKER_PASSWORD=worker_dev

# ── alvos locais ────────────────────────────────────────────────────────────
TARGET_PORT=8081

# ── URLs de conexão ─────────────────────────────────────────────────────────
# migrate usa o superusuário: é o único que faz DDL.
DATABASE_URL_MIGRATE=postgres://monitor:monitor_dev@localhost:5432/monitor?sslmode=disable
# Os serviços conectam DIRETAMENTE como seus papéis — sem SET ROLE, sem
# herança por membership. O trigger de suspended_reason compara current_user, e
# cada serviço afirma no boot que current_user e TimeZone são os esperados.
DATABASE_URL_API=postgres://monitor_api:api_dev@localhost:5432/monitor?sslmode=disable
DATABASE_URL_WORKER=postgres://monitor_worker:worker_dev@localhost:5432/monitor?sslmode=disable

# ── worker em dev ───────────────────────────────────────────────────────────
REGION=sa-east
# Os alvos do seed estão em localhost, e o guard bloqueia rede privada por
# padrão. Sem esta exceção, todo check de dev vira ssrf_blocked.
# AllowedHosts sozinho não bastaria: o dial só conhece o IP, nunca o host.
SSRF_BLOCK_PRIVATE=true
SSRF_ALLOWED_CIDRS=127.0.0.0/8,::1/128
SSRF_ALLOWED_HOSTS=localhost

# Control probes do freio de cegueira. Sem eles o freio NUNCA engata: o quórum
# de probes é condição necessária, e é ele que separa "a nossa rede caiu" de
# "um provedor grande caiu" — o segundo caso TEM que gerar incidente.
#
# Em produção são de 3 a 7 alvos em provedores e redes DISTINTOS. Tudo na mesma
# nuvem não é evidência independente: a queda dessa nuvem derrubaria os probes
# junto com os clientes e o freio engataria numa queda real de provedor.
#
# Em dev eles apontam para o nginx local, que é o suficiente para exercitar o
# engate (basta derrubar o container dos alvos) e não passa pelo guard de SSRF —
# os probes são configuração do operador, não URL de usuário.
CONTROL_PROBE_URLS=http://localhost:8081/ok,http://localhost:8081/redireciona
CONTROL_PROBE_INTERVAL_S=10
CONTROL_PROBE_FAIL_QUORUM=0.6

# ── caminho frio (notificação) ──────────────────────────────────────────────
# Sem as duas variáveis do FCM, o push é impresso no console: dá para exercitar
# o ciclo incidente → notificação → entrega sem projeto no Firebase e sem
# aparelho. Elas andam JUNTAS — o boot recusa meia configuração, porque com uma
# só o push cairia no console em silêncio, parecendo configurado.
#
# As credenciais moram no Worker, que não recebe tráfego da internet. A API
# nunca as vê: ela enfileira, e quem envia é o Worker.
# FCM_CREDENTIALS_PATH=/caminho/para/service-account.json
# FCM_PROJECT_ID=monitor-dev

# console imprime; resend envia de verdade e exige RESEND_API_KEY e EMAIL_FROM.
EMAIL_PROVIDER=console
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=monitor@exemplo.com
# EMAIL_REPLY_TO=suporte@exemplo.com

# Faixa mínima de migration aceita no boot. Nunca igualdade: versão N precisa
# operar contra schema N+1 durante deploy gradual.
#
# A versão aplicada vem de `schema_migrations`, mantida pelo golang-migrate.
# O boot exige dirty=false e version >= SCHEMA_MIN_VERSION. Maior é esperado e
# permitido: é exatamente o deploy gradual.
SCHEMA_MIN_VERSION=12

# ── testes de integração ────────────────────────────────────────────────────
# Aponta a suíte do worker e a da API para um banco já de pé, em vez de
# testcontainers.
MONITOR_TEST_DATABASE_URL=postgres://monitor:monitor_dev@localhost:5432/monitor_test?sslmode=disable
MONITOR_INFRA_DIR=.
