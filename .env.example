# Copie para .env e ajuste. O .env NÃO é versionado.
#
#   cp .env.example .env

# ── Postgres do compose ─────────────────────────────────────────────────────
POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor_dev
POSTGRES_DB=monitor
POSTGRES_PORT=5432

# ── senhas dos papéis da aplicação (migration 011) ──────────────────────────
# Em produção vêm do gestor de segredos, nunca de arquivo.
MONITOR_MIGRATE_PASSWORD=migrate_dev
MONITOR_API_PASSWORD=api_dev
MONITOR_WORKER_PASSWORD=worker_dev

# ── alvos locais ────────────────────────────────────────────────────────────
TARGET_PORT=8081

# ── URLs de conexão ─────────────────────────────────────────────────────────
# migrate usa o superusuário: é o único que faz DDL.
DATABASE_URL_MIGRATE=postgres://monitor:monitor_dev@localhost:5432/monitor?sslmode=disable
# Os serviços conectam DIRETAMENTE como seus papéis — sem SET ROLE, sem
# herança por membership. O trigger de suspended_reason compara current_user, e
# cada serviço afirma no boot que current_user e TimeZone são os esperados.
DATABASE_URL_API=postgres://monitor_api:api_dev@localhost:5432/monitor?sslmode=disable
DATABASE_URL_WORKER=postgres://monitor_worker:worker_dev@localhost:5432/monitor?sslmode=disable

# ── worker em dev ───────────────────────────────────────────────────────────
REGION=sa-east
# Os alvos do seed estão em localhost, e o guard bloqueia rede privada por
# padrão. Sem esta exceção, todo check de dev vira ssrf_blocked.
# AllowedHosts sozinho não bastaria: o dial só conhece o IP, nunca o host.
SSRF_BLOCK_PRIVATE=true
SSRF_ALLOWED_CIDRS=127.0.0.0/8,::1/128
SSRF_ALLOWED_HOSTS=localhost

# Faixa mínima de migration aceita no boot. Nunca igualdade: versão N precisa
# operar contra schema N+1 durante deploy gradual.
#
# A versão aplicada vem de `schema_migrations`, mantida pelo golang-migrate.
# O boot exige dirty=false e version >= SCHEMA_MIN_VERSION. Maior é esperado e
# permitido: é exatamente o deploy gradual.
SCHEMA_MIN_VERSION=12

# ── testes de integração ────────────────────────────────────────────────────
# Aponta a suíte do worker e a da API para um banco já de pé, em vez de
# testcontainers.
MONITOR_TEST_DATABASE_URL=postgres://monitor:monitor_dev@localhost:5432/monitor_test?sslmode=disable
MONITOR_INFRA_DIR=.
